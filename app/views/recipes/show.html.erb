<div class="mx-auto md:w-2/3 w-full">
  <%= render "breadcrumbs", crumbs: [["My Recipes", recipes_path], [@recipe.name, nil]] %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl"><%= @recipe.name %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_recipe_path(@recipe),
            class: "bg-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded hover:bg-gray-300" %>
      <%= button_to "Delete", recipe_path(@recipe), method: :delete,
            data: { turbo_confirm: "Are you sure you want to delete this recipe?" },
            class: "bg-red-600 text-white text-sm font-medium px-4 py-2 rounded hover:bg-red-700" %>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg p-6">
    <% if @recipe.reference_url.present? %>
      <p class="text-sm text-gray-600 mb-4">
        <span class="font-semibold">Reference:</span>
        <% reference_url = recipe_reference_url_for_link(@recipe.reference_url) %>
        <% if reference_url.present? %>
          <%= link_to reference_url, reference_url, target: "_blank", rel: "noopener noreferrer",
                class: "text-blue-600 hover:underline break-all" %>
        <% else %>
          <%= @recipe.reference_url %>
        <% end %>
      </p>
    <% end %>

    <% if @recipe.recipe_ingredients.any? %>
      <h2 class="text-lg font-semibold text-gray-700 mb-2">Ingredients</h2>
      <ul class="list-disc list-inside space-y-1 text-gray-700">
        <% @recipe.recipe_ingredients.includes(:ingredient).each do |ri| %>
          <li><%= ri.display_text %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
