<%= form_with(model: recipe, class: "space-y-4", data: { controller: "recipe-parse", recipe_parse_parse_url_value: recipe.persisted? ? parse_recipe_path(recipe) : "" }) do |form| %>
  <% if recipe.errors.any? %>
    <div class="bg-red-100 text-red-800 px-4 py-2 rounded">
      <ul>
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, required: true,
          class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :reference_url, "Reference URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="flex gap-2">
      <%= form.url_field :reference_url, placeholder: "https://example.com/recipe",
            data: { recipe_parse_target: "urlField" },
            class: "flex-1 border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <% if recipe.persisted? %>
        <button type="button"
                data-action="recipe-parse#parse"
                data-recipe-parse-target="parseButton"
                class="bg-green-600 text-white text-sm font-medium px-4 py-2 rounded hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap">
          Parse URL
        </button>
      <% end %>
    </div>
  </div>

  <div data-controller="ingredients" data-recipe-parse-target="ingredientsSection">
    <h2 class="text-lg font-semibold text-gray-700 mb-2">Ingredients</h2>

    <div data-ingredients-target="container" data-recipe-parse-target="ingredientsContainer" class="space-y-2">
      <% recipe.recipe_ingredients.each_with_index do |ri, index| %>
        <%= render "recipes/ingredient_row", form: form, index: index, recipe_ingredient: ri %>
      <% end %>
    </div>

    <template data-ingredients-target="template" data-recipe-parse-target="ingredientTemplate">
      <%= render "recipes/ingredient_row", form: form, index: "NEW_RECORD", recipe_ingredient: nil %>
    </template>

    <button type="button" data-action="ingredients#add"
            class="mt-2 text-sm text-blue-600 hover:text-blue-800 hover:underline">
      + Add Ingredient
    </button>
  </div>

  <div data-controller="steps">
    <h2 class="text-lg font-semibold text-gray-700 mb-2">Steps</h2>

    <div data-steps-target="container" class="space-y-2">
      <% recipe.steps.each_with_index do |step, index| %>
        <%= render "recipes/step_row", index: index, step: step %>
      <% end %>
    </div>

    <template data-steps-target="template">
      <%= render "recipes/step_row", index: "NEW_RECORD", step: nil %>
    </template>

    <button type="button" data-action="steps#add"
            class="mt-2 text-sm text-blue-600 hover:text-blue-800 hover:underline">
      + Add Step
    </button>
  </div>

  <div data-recipe-parse-target="overlay" class="hidden fixed inset-0 bg-gray-900/50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-8 text-center">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
      <p class="text-gray-700 font-medium">Parsing recipe...</p>
      <p class="text-gray-500 text-sm mt-1">Fetching and analyzing the page</p>
    </div>
  </div>

  <div data-recipe-parse-target="notice" class="hidden bg-yellow-100 text-yellow-800 px-4 py-2 rounded text-sm"></div>

  <div class="flex gap-2">
    <%= form.submit class: "bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
    <%= link_to "Cancel", recipe.persisted? ? recipe_path(recipe) : recipes_path,
          class: "bg-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded hover:bg-gray-300" %>
  </div>
<% end %>
